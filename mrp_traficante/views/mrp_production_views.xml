<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_production_form_view_traficante" model="ir.ui.view">
            <field name="name">mrp.production.form.traficante</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="production_type"/>
                </xpath>
            </field>
        </record>

        <record id="mrp_production_tree_view_traficante" model="ir.ui.view">
            <field name="name">mrp.production.tree.traficante</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="production_type"/>
                </xpath>
            </field>
        </record>

        <record id="view_mrp_production_filter_traficante" model="ir.ui.view">
            <field name="name">mrp.production.select.traficante</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='todo']" position="after">
                    <separator/>
                    <filter string="Composición" name="composicion" domain="[('production_type', '=', 'composicion')]"/>
                    <filter string="Descomposición" name="descomposicion" domain="[('production_type', '=', 'descomposicion')]"/>
                </xpath>
            </field>
        </record>

        <record id="mrp.mrp_production_action" model="ir.actions.act_window">
            <field name="context">{'search_default_todo': True, 'search_default_composicion': 1, 'default_company_id': allowed_company_ids[0]}</field>
        </record>
    </data>
</odoo>
