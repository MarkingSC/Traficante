<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_scrap_form_view_traficante" model="ir.ui.view">
            <field name="name">stock.scrap.form.traficante</field>
            <field name="model">stock.scrap</field>
            <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="justification" widget="text" placeholder="Motivo por el cual se desecha el producto..."/>
                </xpath>
            </field>
        </record>

        <record id="stock_scrap_form_view2_traficante" model="ir.ui.view">
            <field name="name">stock.scrap.form2.traficante</field>
            <field name="model">stock.scrap</field>
            <field name="inherit_id" ref="stock.stock_scrap_form_view2"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='scrap_location_id']" position="after">
                    <field name="justification" widget="text" placeholder="Motivo por el cual se desecha el producto..."/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
